# Copy to .env only for local tooling that loads it; .env is git-ignored.
# The training code does not automatically read .env or print these values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Optional. Qwen/Qwen2.5-1.5B-Instruct is public, so normal downloads do not need it.
HF_TOKEN=

# Required by SEC requests, but this is contact identification rather than a secret.
SEC_USER_AGENT=Your Name your.email@example.com
